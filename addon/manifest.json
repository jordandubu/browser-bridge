{
  "manifest_version": 2,
  "name": "opencode-bridge",
  "version": "1.0",
  "description": "Lets opencode read page content",
  "license": "MIT",
  "permissions": ["nativeMessaging", "activeTab", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opencode-bridge@localhost"
    }
  }
}
