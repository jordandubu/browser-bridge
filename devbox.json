{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": ["nodejs@22"],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": "npx web-ext run --source-dir addon --firefox=firefox",
      "test-tools": "bash tests/test-tools.sh",
      "test-ui": "bash bench/ui/run.sh",
      "bench-ui": "python3 -m http.server 8765 --bind 0.0.0.0 --directory bench/ui",
      "sign": "npx web-ext sign --source-dir addon --channel listed --api-key $AMO_API_KEY --api-secret $AMO_API_SECRET",
      "sign:local": "devbox run --env-file .env sign"
    }
  }
}
